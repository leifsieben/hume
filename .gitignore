# Data and artefacts — regenerable, and far too large for git.
# The 1M corpus alone is 5.6 GB; checkpoints and job tarballs add hundreds of MB.
data/
gpu/devsets/
gpu/payload/
gpu/*.tar.gz
gpu/.instance_*
gpu/.cpu_instance_*
gpu/PROXY
gpu/grid_out/
gpu/graphs.txt
cpp/graphs.txt
models_hf/

# C++ exchange files and build products. These are REGENERABLE and they are enormous at the
# 100k scale the exactness runs use: mols.txt 178 MB, mols_h.txt 144 MB, values_ac.txt 615 MB,
# values_hume.txt 145 MB -- over a gigabyte between them, and each one individually past
# GitHub's hard 100 MB blob limit. They were tracked while the dev sets were 2,000 molecules
# and quietly became unpushable when the corpus grew; untracked in the commit that added
# these lines. Regenerate with cpp/export_predict.py / cpp/export_ac.py / cpp/export_crippen.py
# and the matching `./<binary> verify`.
#
# cpp/hard.smi is DELIBERATELY NOT IGNORED. At 4 MB it is small enough to track, and unlike
# everything above it is not reproducible from this repo -- build_hard_corpus.py sweeps a
# 10M-molecule PubChem file that lives outside it. It is the corpus every exactness claim in
# this project rests on, so it travels with the code.
cpp/mols.txt
cpp/mols_h.txt
cpp/mols.smi
cpp/mols_h.smi
cpp/values*.txt
cpp/crip_*.txt
cpp/crip_*.smi
cpp/mismatch.txt

# Compiled binaries -- rebuilt by the clang++ line in each source file's header comment.
cpp/bench
cpp/hume
cpp/hume_ob
cpp/hume_split
cpp/ac
cpp/predict
cpp/crippen
backups/
logs/
__pycache__/
*.pyc
.venv/
# The mordred oracle environment: python 3.11 + numpy 1.26.4, which the pinned .venv cannot be
# (mordred 1.2.0 imports distutils and requires numpy 1.x). cpp/verify_wiring.py's docstring has
# the three commands that rebuild it. ~400 MB.
.venv-mordred/

# Credentials and keys — never.
*.pem
*.key
.env

# Copies made for shipping to remote boxes; the originals are tracked at the repo root.
gpu/models.py
gpu/blocks.py
gpu/chi.py
gpu/cycles.py
gpu/conjugation.py
gpu/resistance.py
gpu/stereo.py
gpu/prep_*.npz
gpu/ckpt_*.pt
gpu/data/

# Results: keep the small JSON reports, drop the big arrays.
results/**/*.npz
results/**/embeddings/
.DS_Store

# scikit-build-core's CMake tree and the compiled extension. `pip install -e .` regenerates
# both; src/hume_core/*.cpp|.h are the sources and ARE tracked.
build/
src/hume/_core*.so
*.egg-info/

# Eigensolver benchmark build products (cpp/eigen_small.h and the .cpp sources are tracked).
cpp/bench_eigen
cpp/v_*.o

# E-state typer exchange files, same reasoning as cpp/crip_*: estate_mols.txt alone is 57 MB at
# the 100k scale the exactness run uses. Regenerate with `cpp/verify_estate.py all`.
# cpp/estate_tables.h is NOT ignored -- it is generated, but it is the pinned specification the
# C++ asserts against, so its diff is how an upstream RDKit change becomes visible.
cpp/estate_mols.txt
cpp/estate_mols.smi
cpp/estate_stress.txt
cpp/estate_cpp*.txt
cpp/estate_cpp*.smi
cpp/estate_typer

# Descriptor-census exchange file: regenerate with the snippet at the bottom of
# PORT_STATUS.md. 1,613 (descriptor -> mordred family) entries; an input to blocks.split(),
# never a source of truth.
fam.json

# Pure-topology port (RingCount / TopologicalCharge / PathCount) exchange files. Same reasoning
# as cpp/estate_mols.txt: topo3_mols.txt is ~50 MB and topo3_ref.txt ~150 MB at the 100k scale.
# Regenerate with `python cpp/verify_topo3.py all` (pinned, see the docstring). The three
# binaries are build products; the .cpp and the headers under src/hume_core/ are tracked.
cpp/topo3_*.txt
cpp/ringcount
cpp/topocharge
cpp/pathcount

# VSA-binning port (cpp/verify_vsa.py); regenerate, do not commit
cpp/vsa_mols.txt
cpp/vsa_cpp.txt
cpp/vsa
cpp/vsa_stress.txt

# InformationContent exchange files (5 numberings x boundary dumps + mordred oracles).
# Regenerate with cpp/verify_ic.py; see its docstring for the two pinned environments.
cpp/ic_*.txt
cpp/ic_*.smi
cpp/infocontent

# InformationContent / Ipc port (cpp/infocontent.cpp, src/hume_core/infocontent.h).
# The exchange files are large -- ic_in0..7 are eight dumps of the whole 100,000-molecule
# corpus -- and every one of them is regenerated by `cpp/verify_ic.py dump`. The GENERATED
# HEADER src/hume_core/ic_tables.h is deliberately NOT ignored: it carries the resolved rdkit
# version and the spec hash, so it is the drift guard and has to be reviewable in a diff.
cpp/ic_in*.txt
cpp/ic_out*.txt
cpp/ic_mordred*.txt
cpp/ic_rdkit_ipc*.txt
cpp/ic_exact_ipc.txt
cpp/ic_smis.txt
cpp/ic_perception_moved.txt
cpp/infocontent

# Fragment SMARTS engine exchange files (frag_dump.txt is ~300 MB at the 100k scale).
# Regenerate with cpp/verify_frag.py dump / ./cpp/frag. frag_tables.h and frag_program.h are
# GENERATED but tracked -- they are the pinned spec, so their diff is how upstream drift shows.
cpp/frag_dump.txt
cpp/frag_counts.txt
cpp/frag

# Chi / WalkCount port exchange + verification artifacts (cpp/verify_chiwalk.py)
cpp/chiwalk
cpp/chiwalk_mols.txt
cpp/chiwalk_ref.txt
cpp/chiwalk_cpp.txt
cpp/chiwalk_pw.txt
cpp/chiwalk_log.txt
cpp/chiwalk_perm*.txt
cpp/chiwalk_bench.smi
cpp/chiwalk_bench_mols.txt

# cpp/constit.cpp exchange + verification artifacts (cpp/verify_constit.py --dump regenerates
# them; constit_in.txt is ~400 MB at 100,000 molecules).  constit_meta.json is small but is a
# RUN RECORD, not a source: it carries the resolved oracle versions of the run that produced
# constit_ref.txt, and keeping a stale one would be worse than having none.
cpp/constit
cpp/constit_in.txt
cpp/constit_ref.txt
cpp/constit_cpp.txt
cpp/constit_meta.json

# cpp/verify_ac.py resumable mordred reference cache (427 MB memmap + its key)
cpp/.ac_ref_cache.*
